<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/root_main2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        style="@style/Widget.ITCompanies.TopAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Companies"
        app:navigationIcon="@android:drawable/ic_menu_sort_by_size"
        app:menu="@menu/menu_main" />

    <!-- Scroll View -->
    <ScrollView
        android:id="@+id/scroll_main2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp"
        android:paddingTop="?attr/actionBarSize"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/containerCompanies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card for Alpha -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAlpha"
                style="@style/ITCompaniesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="60dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/imgAlpha"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/logo_bg_round"
                        android:contentDescription="@string/company_logo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/it1" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAlphaTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ZETA BOX"
                            style="@style/Text.ITCompanies.Title" />

                        <TextView
                            android:id="@+id/tvAlphaSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dev mobile • Java • Cloud"
                            style="@style/Text.ITCompanies.Subtitle" />

                        <!-- Boutons Update et Delete pour Alpha -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAlphaUpdate"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:text="Update"
                                android:textSize="12sp"
                                android:minWidth="60dp"
                                android:minHeight="32dp"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAlphaDelete"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Delete"
                                android:textSize="12sp"
                                android:minWidth="60dp"
                                android:minHeight="32dp"
                                android:backgroundTint="@color/error"
                                app:cornerRadius="8dp" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card for Beta -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBeta"
                style="@style/ITCompaniesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/imgBeta"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/logo_bg_round"
                        android:contentDescription="@string/company_logo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/it2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvBetaTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SOFTTODO"
                            style="@style/Text.ITCompanies.Title" />

                        <TextView
                            android:id="@+id/tvBetaSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IA/ML • Data Engineering • DevOps"
                            style="@style/Text.ITCompanies.Subtitle" />

                        <!-- Boutons Update et Delete pour Beta -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBetaUpdate"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:text="Update"
                                android:textSize="12sp"
                                android:minWidth="60dp"
                                android:minHeight="32dp"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBetaDelete"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Delete"
                                android:textSize="12sp"
                                android:minWidth="60dp"
                                android:minHeight="32dp"
                                android:backgroundTint="@color/error"
                                app:cornerRadius="8dp" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card for Gamma -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGamma"
                style="@style/ITCompaniesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/imgGamma"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/logo_bg_round"
                        android:contentDescription="@string/company_logo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/it3" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvGammaTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Next-IT"
                            style="@style/Text.ITCompanies.Title" />

                        <TextView
                            android:id="@+id/tvGammaSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cybersécurité • Pentest • SOC"
                            style="@style/Text.ITCompanies.Subtitle" />

                        <!-- Boutons Update et Delete pour Gamma -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnGammaUpdate"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:text="Update"
                                android:textSize="12sp"
                                android:minWidth="60dp"
                                android:minHeight="32dp"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnGammaDelete"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Delete"
                                android:textSize="12sp"
                                android:minWidth="60dp"
                                android:minHeight="32dp"
                                android:backgroundTint="@color/error"
                                app:cornerRadius="8dp" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Floating Action Button pour ajouter une nouvelle entreprise -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddCompany"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Ajouter une entreprise"
        app:tint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
