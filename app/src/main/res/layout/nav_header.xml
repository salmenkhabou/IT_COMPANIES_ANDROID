<?xml version="1.0" encoding="utf-8"?>
<!-- filepath: c:\Android_Native\TP5EX2\app\src\main\res\layout\nav_header.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:background="@color/brand_primary"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="16dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <!-- Avatar de l'utilisateur -->
    <ImageView
        android:id="@+id/nav_header_avatar"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/circle_background"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_myplaces"
        android:contentDescription="Avatar utilisateur" />

    <!-- Nom de l'utilisateur -->
    <TextView
        android:id="@+id/nav_header_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Utilisateur"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Email de l'utilisateur -->
    <TextView
        android:id="@+id/nav_header_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="email@example.com"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:alpha="0.8" />

</LinearLayout>
