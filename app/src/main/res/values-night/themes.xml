<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Thème sombre de l'application -->
    <style name="Theme.ITCompanies" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorError">@color/error</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialButtonStyle">@style/App.Button.Filled</item>
        <item name="textInputStyle">@style/App.TextInputLayout</item>
        <item name="toolbarStyle">@style/Widget.ITCompanies.TopAppBar</item>
    </style>

    <style name="Widget.ITCompanies.TopAppBar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="titleTextColor">@color/on_surface</item>
        <item name="subtitleTextColor">@color/on_surface_variant</item>
        <item name="navigationIconTint">@color/on_surface</item>
        <item name="menu">@menu/menu_main</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="App.Button.Filled" parent="Widget.Material3.Button">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingVertical">14dp</item>
    </style>

    <style name="App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxStrokeColor">@color/brand_primary</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/on_surface_variant</item>
        <item name="helperTextTextColor">@color/on_surface_variant</item>
        <item name="errorTextColor">@color/error</item>
        <item name="endIconTint">@color/on_surface_variant</item>
    </style>

    <style name="Text.ITCompanies.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Text.ITCompanies.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <style name="ITCompaniesCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>